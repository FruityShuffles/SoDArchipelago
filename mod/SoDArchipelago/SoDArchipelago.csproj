<Project Sdk="Microsoft.NET.Sdk">

  <!-- Optional per-machine override of GameDir; see GamePath.user.props.example. -->
  <Import Project="..\GamePath.user.props" Condition="Exists('..\GamePath.user.props')" />

  <PropertyGroup>
    <!-- Mirrors the official Mods/ModTemplate/TestMod.csproj settings. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>SoDArchipelago</RootNamespace>
    <AssemblyName>SoDArchipelago</AssemblyName>
    <!-- Copy NuGet runtime DLLs (Archipelago.MultiClient.Net) to the output folder. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <GameDir Condition="'$(GameDir)' == '' and '$(SOD_GAME_DIR)' != ''">$(SOD_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Shape of Dreams</GameDir>
    <GameManagedDir>$(GameDir)\Shape of Dreams_Data\Managed</GameManagedDir>
    <ModDeployDir>$(GameDir)\Mods\SoDArchipelago</ModDeployDir>
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.1" />
    <!-- Build tool only: merges MultiClient.Net into our DLL (target MergeMultiClient). -->
    <PackageReference Include="ILRepack" Version="2.0.48" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Game / engine assemblies: compile-time only, never copied. Add more from Managed\ as needed. -->
  <ItemGroup>
    <GameRef Include="mscorlib;netstandard;System;System.Core" />
    <GameRef Include="0Harmony;Assembly-CSharp;Dew.Core;Dew.Contents;Dew.External;Dew.UI" />
    <GameRef Include="UnityEngine.CoreModule;UnityEngine.IMGUIModule;UnityEngine.InputLegacyModule;UnityEngine.UI;UnityEngine.TextRenderingModule;Unity.TextMeshPro" />
    <GameRef Include="Mirror;Newtonsoft.Json;UniTask;com.rlabrecque.steamworks.net" />
    <Reference Include="@(GameRef)">
      <HintPath>$(GameManagedDir)\%(Identity).dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Shared item/location table generated by tools/extract_game_data.py. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\apworld\shape_of_dreams\data\game_data.json" LogicalName="SoDArchipelago.game_data.json" />
  </ItemGroup>

  <Target Name="CheckGameDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameManagedDir)\Dew.Core.dll')"
           Text="Shape of Dreams not found at '$(GameDir)'. Set SOD_GAME_DIR or create mod\GamePath.user.props." />
  </Target>

  <!-- The mod loader checks every type of each mod DLL (IsAssignableFrom) before any of our code runs, and loads mod DLLs
       under renamed identities, so a separate Archipelago.MultiClient.Net.dll can't be resolved from ours at that point.
       Merging it into SoDArchipelago.dll leaves no reference to resolve. -->
  <Target Name="MergeMultiClient" AfterTargets="Build"
          Inputs="$(OutDir)SoDArchipelago.dll;$(OutDir)Archipelago.MultiClient.Net.dll"
          Outputs="$(OutDir)merged\SoDArchipelago.dll">
    <MakeDir Directories="$(OutDir)merged" />
    <Exec Command="&quot;$(ILRepack)&quot; /lib:&quot;$(GameManagedDir)&quot; /out:&quot;$(OutDir)merged\SoDArchipelago.dll&quot; &quot;$(OutDir)SoDArchipelago.dll&quot; &quot;$(OutDir)Archipelago.MultiClient.Net.dll&quot;" />
  </Target>

  <!-- Lay out the mod folder the in-game mod manager expects: <Mods>\SoDArchipelago\{about\, SoDArchipelago.dll}. -->
  <Target Name="DeployMod" AfterTargets="MergeMultiClient" Condition="'$(DeployToGame)' == 'true'">
    <ItemGroup>
      <ModAbout Include="about\**\*" />
      <ModDll Include="$(OutDir)merged\SoDArchipelago.dll;$(OutDir)merged\SoDArchipelago.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(ModAbout)" DestinationFolder="$(ModDeployDir)\about\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ModDll)" DestinationFolder="$(ModDeployDir)" SkipUnchangedFiles="true" Condition="Exists('%(FullPath)')" />
    <!-- Left over from builds before the merge. -->
    <Delete Files="$(ModDeployDir)\Archipelago.MultiClient.Net.dll" />
    <Message Importance="high" Text="Deployed mod to $(ModDeployDir)" />
  </Target>

</Project>
